{
  "cli": {
    "version": ">=25",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "env": {
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true,
        "resourceClass": "large"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    },
    "development-simulator": {
      "extends": "development",
      "env": {
        "DISABLE_UPDATES": "1",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    },
    "e2e": {
      "extends": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "e2e",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com",
        "NODE_ENV": "development",
        "RN_SRC_EXT": "e2e.ts,e2e.tsx"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "large"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    },
    "production": {
      "extends": "base",
      "ios": {
        "resourceClass": "large",
        "autoIncrement": true,
        "buildArtifactPaths": ["ios/build/*"]
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    },
    "testflight": {
      "extends": "base",
      "ios": {
        "autoIncrement": true,
        "buildArtifactPaths": ["ios/build/*"]
      },
      "android": {
        "autoIncrement": true
      },
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_ENV": "testflight",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    },
    "testflight-android": {
      "extends": "base",
      "ios": {
        "autoIncrement": true,
        "buildArtifactPaths": ["ios/build/*"]
      },
      "android": {
        "autoIncrement": true
      },
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_ENV": "testflight",
        "EXPO_PUBLIC_QUANTZING_DOMAIN": "quantzing.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.quantzing.app"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production"
      }
    },
    "testflight-android": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
